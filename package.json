{
  "name": "frontend-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "hooks:install": "sh ./scripts/install-hooks.sh"
  },
  "dependencies": {
    "@weluvabid/iris": "0.4.1",
    "qr": "0.7.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/svelte": "9.1.2",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.1.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
