---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { domainById, domains } from '@data/domains';
import { assertValidQuestionGraph } from '@lib/content';
import { questionHref } from '@lib/atlas';

export async function getStaticPaths() {
  const entries = await getCollection('questions');
  const questions = assertValidQuestionGraph(entries);
  return domains.map((domain) => ({
    params: { domain: domain.id },
    props: { domain, questions: questions.filter((question) => question.domain === domain.id) },
  }));
}

const { domain, questions } = Astro.props;
if (!domainById.has(domain.id)) throw new Error(`Unknown domain route: ${domain.id}`);
const difficultyOrder = { foundation: 0, intermediate: 1, advanced: 2 } as const;
const ordered = [...questions].sort((left, right) => difficultyOrder[left.difficulty] - difficultyOrder[right.difficulty] || left.title.localeCompare(right.title)).map((question) => {
  return { ...question, url: questionHref(question.id) };
});
---

<BaseLayout title={`${domain.name} — Frontend Atlas`} description={domain.description}>
  <nav class="mb-8 text-sm text-muted-foreground" aria-label="Breadcrumb"><a href="/domains/" class="hover:text-foreground">Domains</a><span class="mx-2" aria-hidden="true">/</span><span aria-current="page">{domain.name}</span></nav>
  <header class="mb-10 max-w-3xl">
    <p class="eyebrow">{questions.length} curated questions</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{domain.name}</h1>
    <p class="mt-4 text-base leading-8 text-muted-foreground">{domain.description}</p>
  </header>
  <ol class="space-y-3">
    {ordered.map((question, index) => (
      <li>
        <a class="atlas-card group flex flex-col gap-4 rounded-2xl border border-border bg-card p-5 no-underline transition-colors hover:border-ring sm:flex-row sm:items-start sm:justify-between" href={question.url}>
          <div class="flex gap-4">
            <span class="pt-1 text-xs tabular-nums text-muted-foreground">{String(index + 1).padStart(2, '0')}</span>
            <div><h2 class="font-semibold tracking-tight group-hover:text-primary">{question.title}</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">{question.summary}</p></div>
          </div>
          <span class="shrink-0 text-xs capitalize text-muted-foreground">{question.difficulty} · {question.minutes} min</span>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>
