---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Button, Empty } from '@weluvabid/iris/components';
import { withBase } from '@lib/atlas';
---

<BaseLayout
  title="Page not found — Frontend Atlas"
  description="The page you requested could not be found."
>
  <Empty.Root class="mx-auto max-w-2xl border-0 py-16">
    <Empty.Header>
      <Empty.Title class="text-4xl tracking-tight">This page isn't in the atlas.</Empty.Title>
      <Empty.Description class="max-w-lg text-sm leading-7"
        >404 · Not found. The link may have moved, or the page may never have existed. Try searching
        the handbook or return to the domain map.</Empty.Description
      >
    </Empty.Header>
    <Empty.Content class="flex-row justify-center gap-3">
      <Button.Root class="rounded-full" href={withBase('/search/')}>Search the handbook</Button.Root>
      <Button.Root variant="outline" class="rounded-full" href={withBase('/domains/')}
        >Browse domains</Button.Root
      >
    </Empty.Content>
  </Empty.Root>
</BaseLayout>
